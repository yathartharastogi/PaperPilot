# PaperPilot Environment Configuration (100% Free / Zero Paid API Keys Required)
PORT=8000
ENVIRONMENT=development
MOCK_AUTH=true

# Free / Local LLM Engine Mode
# Options: "mock_local" (100% free, built-in intelligent parsing, zero API key needed)
#          "gemini" (using free-tier Google Gemini API key if provided)
LLM_PROVIDER=mock_local

# Optional Free Tier Gemini Key (Leave blank to run 100% offline & keyless via mock_local engine)
GEMINI_API_KEY=

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://paperpilot:paperpilot_password@localhost:5432/paperpilot_db

# Redis Task Queue
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=paperpilot-papers
